DATABASE_URL=postgres://...neon.tech/neondb   # the app's own Neon DB
ENC_KEY=long-random-string                    # encrypts stored connection strings
TG_BOT_TOKEN=123:ABC
TG_ADMIN_ID=123456789                         # only this Telegram user can use the bot
TG_WEBHOOK_SECRET=random-string
CRON_SECRET=random-string                     # Vercel sends it to /api/cron
ADMIN_PASSWORD=choose-one                     # dashboard login (any username)
RUNNER_TOKEN=random-string                    # shared with GitHub secret RUNNER_TOKEN
GH_REPO=im4tta/backupdeck                     # owner/repo that holds the workflow
GH_TOKEN=github_pat_...                       # fine-grained PAT, Actions: read & write
